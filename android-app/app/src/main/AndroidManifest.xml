<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice trading: the mic is only used while the user holds the
         tap-to-talk button, and only for the voice order and the voice
         check. The feature is optional: without a microphone the app
         works exactly as before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrognosLabs"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PrognosLabs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Return from the wallet link page: the page redirects here
                 with the trading session after the user signs. Dormant
                 until the site sends that redirect (see WalletLink.kt);
                 without it the app never receives a session.
                 autoVerify makes the https link a verified App Link, so
                 Android opens the app straight from the redirect instead
                 of asking which app to use. The site must serve
                 /.well-known/assetlinks.json with this app's signing
                 certificate fingerprint. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="prognoslabs.xyz" android:path="/linked" />
                <data android:scheme="prognoslabs" android:host="linked" />
            </intent-filter>
        </activity>
    </application>
</manifest>
