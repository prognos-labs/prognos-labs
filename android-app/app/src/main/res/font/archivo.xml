<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo, bundled in the APK so the app never inherits the phone's
     system font. OFL licensed, from Google Fonts (github.com/google/fonts).
     Static instances per weight, subset to Latin + punctuation, generated
     with fontTools instancer + subset. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/archivo_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/archivo_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/archivo_semibold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/archivo_bold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/archivo_extrabold" />
</font-family>
